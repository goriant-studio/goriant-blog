>>> SCRIPT CONTENT <<<
-- Developer: Kevin
-- Ticket: SUP-140008
-- Purpose: check past 12 month SSBO1.3 BO user export log
-- Last modified by: Kevin
-- Last modified date: 2025-12-12 11:00:00

SELECT
    `created_by`,
    `created_date`,
    `user_token`,  -- typically formatted as super_bo_{login}; included for request source auditing
    `generated_time`,
    `status`,
    `params`,
    `report`
FROM `CashMarket`.`bo_gateway_export_request`
WHERE `merchant_id` = 81
  AND `report` IN ('MEMBER_EDIT', 'MEMBER_EDIT_V2', 'MEMBER_EDIT_V3')
  AND `created_date` > CURDATE() - INTERVAL 12 MONTH
ORDER BY `created_date` DESC;
>>> END CONTENT <<<



