---
import DevlogLayout from "../../../layouts/DevlogLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import Image from "astro/components/Image.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog-en");

  return posts.map((entry) => {
    const slug = entry.id.split("/").pop()?.replace(/\.(md|mdx)$/, "");
    return {
      params: { slug },
      props: { id: entry.id },
    };
  });
}

const { id } = Astro.props;

const post: any = await getEntry("blog-en", id);
const { Content } = await render(post);

// GET POSTS FOR SIDEBAR
const posts = (await getCollection("blog-en"))
  .filter((p) => p.data.game === "maze-escape")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const currentSlug = post.id.split("/").pop()?.replace(/\.(md|mdx)$/, "");
const cover = post.data.heroImage;
---

<DevlogLayout
  lang="en"
  posts={posts}
  currentSlug={currentSlug}
>
  <a
    href="/en/blog"
    class="text-sm text-white/60 hover:text-white transition"
  >
    ← Back to devlog list
  </a>

  <header class="mt-6">

    {cover && (
      <Image 
        class="w-auto h-auto"
        alt={post.data.title}
        width={1020}
        height={510}
        src={cover}
      />
    )}

    <p class="text-sm text-white/50">
      {post.data.date.toLocaleDateString("en-US")}
    </p>

    <h1 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">
      {post.data.title}
    </h1>

    {post.data.description && (
      <p class="mt-4 text-white/70">
        {post.data.description}
      </p>
    )}
  </header>

  <article class="mt-10">
    <Content />
  </article>
</DevlogLayout>