---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout lang="en">
  <main class="mx-auto max-w-6xl px-6 pt-40 pb-28">
    <header class="mb-10">
      <h1 class="text-3xl font-extrabold text-white">🎮 Games</h1>
      <p class="mt-3 max-w-2xl text-white/70">
        A list of indie games I’m currently developing. Each game has its own page
        where you can track progress, read devlogs, and play the web version.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      <!-- MazeEscape card -->
      <div
        class="rounded-2xl bg-white/5 backdrop-blur border border-white/10 p-6
           hover:border-white/20 transition"
      >
        <!-- Game image -->
        <img
          src="/images/maze-escape.png"
          alt="MazeEscape gameplay"
          class="mb-4 aspect-video w-full rounded-xl
             object-cover border border-white/10"
          loading="lazy"
        />

        <h2 class="text-xl font-semibold text-white">MazeEscape</h2>

        <p class="mt-2 text-sm text-white/70">
          A top-down maze game focused on movement, dodging enemies,
          and level design.
        </p>

        <ul class="mt-3 text-xs text-white/60 space-y-1">
          <li>• Status: Early Prototype</li>
          <li>• Engine: Godot</li>
          <li>• Platforms: Web, Android</li>
        </ul>

        <div class="mt-5 flex gap-4">
          <a
            href="/en/games/maze-escape"
            class="rounded-full bg-purple-600 px-4 py-2 text-sm text-white"
          >
            View game
          </a>
          <a
            href="/en/games/maze-escape/play"
            class="inline-flex items-center justify-center rounded-full
               bg-gradient-to-r from-purple-500 to-blue-500
               px-6 py-3 text-sm font-medium text-white
               hover:from-blue-500 hover:to-purple-500 transition"
          >
            Play on web →
          </a>
        </div>
      </div>

      <!-- Snake3D card -->
      <div
        class="rounded-2xl bg-white/5 backdrop-blur border border-white/10 p-6
           hover:border-white/20 transition"
      >
        <div
          class="mb-4 aspect-video w-full rounded-xl flex items-center justify-center
             bg-gradient-to-br from-green-900/40 to-teal-900/40 border border-white/10
             text-6xl"
        >
          🐍
        </div>

        <h2 class="text-xl font-semibold text-white">Snake3D</h2>

        <p class="mt-2 text-sm text-white/70">
          A modern 3D take on the classic snake game, built with Three.js.
          Navigate 3D space, eat food, and grow!
        </p>

        <ul class="mt-3 text-xs text-white/60 space-y-1">
          <li>• Status: Web Prototype</li>
          <li>• Engine: Three.js</li>
          <li>• Platforms: Web</li>
        </ul>

        <div class="mt-5 flex gap-4">
          <a
            href="/en/games/snake-3d"
            class="rounded-full bg-green-600 px-4 py-2 text-sm text-white"
          >
            View game
          </a>
          <a
            href="/en/games/snake-3d/play"
            class="inline-flex items-center justify-center rounded-full
               bg-gradient-to-r from-green-500 to-teal-500
               px-6 py-3 text-sm font-medium text-white
               hover:from-teal-500 hover:to-green-500 transition"
          >
            Play on web →
          </a>
        </div>
      </div>

      <!-- Juice Fruit card -->
      <div
        class="rounded-2xl bg-white/5 backdrop-blur border border-white/10 p-6
           hover:border-white/20 transition"
      >
        <!-- Game image -->
        <img
          src="/images/juice-fruit-game.jpg"
          alt="Juice Fruit gameplay"
          class="mb-4 aspect-video w-full rounded-xl
             object-cover border border-white/10"
          loading="lazy"
        />

        <h2 class="text-xl font-semibold text-white">Juice Fruit</h2>

        <p class="mt-2 text-sm text-white/70">
          A memory game where you flip matching card pairs.
        </p>

        <ul class="mt-3 text-xs text-white/60 space-y-1">
          <li>• Status: Early Prototype</li>
          <li>• Engine: Godot</li>
          <li>• Platforms: Web, Android</li>
        </ul>

        <div class="mt-5 flex gap-4">
          <div
            class="inline-flex items-center justify-center rounded-full
               bg-gradient-to-r from-purple-500 to-blue-500
               px-6 py-3 text-sm font-medium text-white
               hover:from-blue-500 hover:to-purple-500 transition"
          >
            Grinding hard on this one 😄
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>