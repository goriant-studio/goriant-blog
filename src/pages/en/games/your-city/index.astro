---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout lang="en">
  <main class="mx-auto max-w-7xl px-6 pt-40 pb-28">
    <a href="/en/games" class="text-sm text-white/60 hover:text-white">
      ← Back to Games
    </a>

    <header class="mt-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">Your City</h1>
      <p class="mt-3 max-w-2xl text-white/70">
        A SimCity-inspired city-building game built with Phaser 3. Place roads,
        zones, and buildings to grow your own city from scratch!
      </p>
    </header>

    <section class="mt-10 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-lg font-semibold text-white">Features</h2>
        <ul class="mt-3 text-sm text-white/70 space-y-1">
          <li>• Isometric grid map with Phaser 3</li>
          <li>• Road & zone placement system</li>
          <li>• Building construction & upgrades</li>
          <li>• AI-generated isometric art</li>
        </ul>

        <div class="mt-6 flex gap-4">
          <a
            href="/en/games/your-city/play"
            class="inline-flex items-center justify-center rounded-full
                 bg-gradient-to-r from-amber-500 to-orange-500
                 px-6 py-3 text-sm font-medium text-white
                 hover:from-amber-400 hover:to-orange-400 transition-all"
          >
            🎮 Play Now
          </a>
        </div>
      </div>

      <div class="rounded-xl overflow-hidden border border-white/10 bg-black">
        <iframe
          src="https://your-city.goriant.com"
          class="w-full aspect-video"
          loading="lazy"
        ></iframe>
      </div>
    </section>
  </main>
</BaseLayout>
