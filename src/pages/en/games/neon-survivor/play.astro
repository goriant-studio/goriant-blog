---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout lang="en">
  <main class="mx-auto max-w-7xl px-6 pt-40 pb-28">
    <a href="/en/games/neon-survivor" class="text-sm text-white/60 hover:text-white">
      ← Back to Neon Survivor
    </a>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-white">
          Play Neon Survivor (Web Prototype)
        </h1>

        <p class="mt-3 max-w-2xl text-white/70 text-sm">
          Survive the cyber swarm solo or connect with a friend in Co-op mode!
          Stay close to your teammate to activate the Laser Tether.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="https://neon-protocol-swarm.lamle.workers.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-white/5 hover:bg-white/15 border border-white/10 px-4 py-2.5 text-sm font-medium text-white/80 hover:text-white transition"
        >
          ↗ Open in New Tab
        </a>
        <button
          id="fullscreen-btn"
          class="inline-flex items-center gap-2 rounded-full bg-white/10 hover:bg-white/20 border border-white/15 px-5 py-2.5 text-sm font-medium text-white transition cursor-pointer"
        >
          <span>⛶</span> Fullscreen
        </button>
      </div>
    </div>

    <div
      id="game-wrapper"
      class="relative mt-8 aspect-video rounded-xl overflow-hidden border border-white/10 bg-black"
    >
      <button
        id="exit-fullscreen-btn"
        class="hidden absolute top-3 right-3 z-50 rounded-full bg-black/70 hover:bg-black/90 border border-white/20 px-3 py-1.5 text-xs font-medium text-white backdrop-blur transition cursor-pointer"
      >
        ✕ Exit Fullscreen
      </button>

      <!-- Neon Survivor embed -->
      <iframe
        id="game-iframe"
        src="https://neon-protocol-swarm.lamle.workers.dev"
        class="w-full h-full"
        allow="fullscreen; autoplay; clipboard-read; clipboard-write"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>

    <p class="mt-4 text-xs text-white/50">
      If you encounter issues, try reloading the page or using a different browser.
    </p>
  </main>

  <style>
    .ios-fullscreen {
      position: fixed !important;
      inset: 0 !important;
      z-index: 9999 !important;
      width: 100vw !important;
      height: 100dvh !important;
      margin: 0 !important;
      border-radius: 0 !important;
      border: none !important;
      aspect-ratio: unset !important;
    }
  </style>

  <script>
    const btn = document.getElementById("fullscreen-btn");
    const exitBtn = document.getElementById("exit-fullscreen-btn");
    const wrapper = document.getElementById("game-wrapper") as any;

    function togglePseudoFullscreen(force?: boolean) {
      const isPseudo = wrapper?.classList.toggle("ios-fullscreen", force);
      if (isPseudo) {
        exitBtn?.classList.remove("hidden");
        document.body.style.overflow = "hidden";
      } else {
        exitBtn?.classList.add("hidden");
        document.body.style.overflow = "";
      }
    }

    function enterFullscreen() {
      const doc = document as any;
      if (doc.fullscreenElement || doc.webkitFullscreenElement) {
        if (doc.exitFullscreen) doc.exitFullscreen();
        else if (doc.webkitExitFullscreen) doc.webkitExitFullscreen();
        return;
      }

      if (wrapper?.classList.contains("ios-fullscreen")) {
        togglePseudoFullscreen(false);
        return;
      }

      const req = wrapper?.requestFullscreen || wrapper?.webkitRequestFullscreen;
      if (req) {
        Promise.resolve(req.call(wrapper)).catch(() => {
          togglePseudoFullscreen(true);
        });
      } else {
        togglePseudoFullscreen(true);
      }
    }

    btn?.addEventListener("click", enterFullscreen);
    exitBtn?.addEventListener("click", () => togglePseudoFullscreen(false));
  </script>
</BaseLayout>
