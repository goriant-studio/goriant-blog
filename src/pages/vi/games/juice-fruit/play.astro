---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout lang="vi">
  <main class="mx-auto max-w-7xl px-6 pt-40 pb-28">
    <a href="/vi/games/juice-fruit" class="text-sm text-white/60 hover:text-white">
      ← Quay lại Juice Fruit
    </a>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-white">
          Chơi Juice Fruit (Web Prototype)
        </h1>

        <p class="mt-3 max-w-2xl text-white/70 text-sm">
          Đây là phiên bản Web được xây dựng bằng Phaser 3.
          Lật các cặp thẻ giống nhau trước khi hết thời gian!
        </p>
      </div>

      <button
        id="fullscreen-btn"
        class="inline-flex items-center gap-2 rounded-full bg-white/10 hover:bg-white/20 border border-white/15 px-5 py-2.5 text-sm font-medium text-white transition cursor-pointer"
      >
        <span>⛶</span> Toàn màn hình
      </button>
    </div>

    <div
      id="game-wrapper"
      class="mt-8 aspect-video rounded-xl overflow-hidden border border-white/10 bg-black"
    >
      <!-- JuiceFruite embed -->
      <iframe
        id="game-iframe"
        src="/games/JuiceFruite/index.html"
        class="w-full h-full"
        allow="fullscreen"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>

    <p class="mt-4 text-xs text-white/50">
      Nếu gặp lỗi, hãy reload trang hoặc thử trình duyệt khác.
    </p>
  </main>

  <script>
    const btn = document.getElementById("fullscreen-btn");
    const wrapper = document.getElementById("game-wrapper");

    btn?.addEventListener("click", () => {
      if (!document.fullscreenElement) {
        wrapper?.requestFullscreen().catch((err) => {
          console.error(`Error attempting to enable fullscreen: ${err.message}`);
        });
      } else {
        document.exitFullscreen();
      }
    });
  </script>
</BaseLayout>

