---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout lang="vi">
  <main class="mx-auto max-w-7xl px-6 pt-40 pb-28">
    <a href="/vi/games" class="text-sm text-white/60 hover:text-white">
      ← Quay lại Games
    </a>

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
          Hearth
        </h1>
        <span
          class="rounded-full bg-amber-500/20 border border-amber-400/30 px-3 py-1 text-xs font-medium text-amber-200"
        >
          CHIẾN THUẬT · XÂY DỰNG &amp; CHIẾN ĐẤU
        </span>
      </div>
      <p class="mt-3 max-w-2xl text-white/70">
        Hearth là game chiến thuật xây dựng vương quốc. Dựng nhà quanh
        ngọn lửa quê hương, làm nông trại nuôi dân, huấn luyện lính giáo và cung
        thủ, rồi dẫn quân ra trận chống lại lũ cướp đang đe dọa vùng đất của bạn.
      </p>
    </header>

    <section class="mt-10 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-lg font-semibold text-white">Tính năng &amp; Trạng thái</h2>
        <ul class="mt-3 text-sm text-white/70 space-y-1.5">
          <li>• Bản Web đã chơi được (Web Prototype)</li>
          <li>• Xây nhà, tường thành và lâu đài quanh ngọn lửa</li>
          <li>• Trồng trọt, chăn nuôi để phát triển kinh tế</li>
          <li>• Huấn luyện lính giáo, cung thủ và anh hùng trong doanh trại</li>
          <li>• Chiến đấu với lũ cướp để bảo vệ và mở rộng lãnh thổ</li>
        </ul>

        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/vi/games/hearth/play"
            class="rounded-full bg-amber-600 hover:bg-amber-500 px-5 py-2.5 text-sm font-medium text-white transition"
          >
            ▶ Chơi bản Web
          </a>
        </div>
      </div>

      <div
        class="rounded-xl bg-white/10 border border-white/10 p-4 text-white/60"
      >
        Tranh minh họa
        <img
          src="/images/hearth.svg"
          alt="Tranh Hearth: ngôi làng lâu đài rực sáng với nông trại và cối xay gió lúc hoàng hôn, hiệp sĩ chỉ huy dẫn lính và cung thủ đánh lũ cướp sừng"
          class="mt-2 mb-2 aspect-video w-full rounded-xl object-cover border border-amber-500/30"
          loading="lazy"
        />
      </div>
    </section>
  </main>
</BaseLayout>
