---
import vi from "../../i18n/vi";
import en from "../../i18n/en";

const pathname = Astro.url.pathname;
const lang = pathname.startsWith("/en") ? "en" : "vi";
const t = lang === "en" ? en : vi;

// remove /vi or /en from path
const rawPath = pathname.replace(/^\/(vi|en)/, "") || "/";
const switchTo = (target: "vi" | "en") => `/${target}${rawPath}`;
---

<footer
  class="relative bg-gradient-to-b from-black via-[#020617] to-black
         border-t border-white/10"
>
  <!-- subtle glow -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px
              bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>

  <div class="mx-auto max-w-5xl px-6 py-16 text-sm text-white/70">

    <!-- TOP -->
    <div class="grid gap-12 md:grid-cols-3">

      <!-- Brand -->
      <div class="md:col-span-2">
        <p
          class="text-xl font-semibold text-white
                 tracking-wide"
        >
          {t.site.title}
        </p>

        <p class="mt-4 max-w-md leading-relaxed text-white/70">
          {t.site.tagline}<br />
          <span class="text-white/50">{t.site.subline}</span>
        </p>
      </div>

      <!-- Explore -->
      <div class="md:justify-self-end">
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-white/50">
          {t.footer.explore}
        </p>

        <ul class="space-y-3">
          <li>
            <a href={`/${lang}`} class="hover:text-white transition">
              {t.footer.home}
            </a>
          </li>
          <li>
            <a href={`/${lang}/games`} class="hover:text-white transition">
              {t.footer.games}
            </a>
          </li>
          <li>
            <a href={`/${lang}/blog`} class="hover:text-white transition">
              {t.footer.blog}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- DIVIDER -->
    <div class="my-12 h-px bg-white/10"></div>

    <!-- BOTTOM -->
    <div class="flex flex-col gap-4 text-xs text-white/50 md:flex-row md:items-center md:justify-between">

      <span>© 2025 Goriant</span>

      <!-- Language -->
      <div class="flex items-center gap-3">
        <a
          href={switchTo("vi")}
          class={lang === "vi"
            ? "text-white"
            : "hover:text-white"}
        >
          🇻🇳 VI
        </a>
        <span class="text-white/20">/</span>
        <a
          href={switchTo("en")}
          class={lang === "en"
            ? "text-white"
            : "hover:text-white"}
        >
          🇺🇸 EN
        </a>
      </div>

      <span class="text-white/40">
        {t.footer.meta}
      </span>
    </div>

  </div>
</footer>
